+    for cue in _TRACKING_STATUS_QUESTION.finditer(text):
+        if cue.start() <= match.start() < cue.end():
+            return True
+    for status in _TRACKING_STATUS_PHRASE.finditer(text):
+        if status.start() <= match.start() < status.end():
+            return True
+        if status.end() >= match.start():
+            continue
+        complement = text[status.end():match.start()]
+        if (re.match(r"\s+(?:of|for|about)\b", complement, re.IGNORECASE)
+                and not re.search(r"\b(?:and|but|then)\b|[;:!?.,]", complement,
+                                  re.IGNORECASE)):
+            return True
+    return False
